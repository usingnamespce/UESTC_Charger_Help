# 将所需的站点块合并到 /etc/caddy/Caddyfile，去掉该块的注释。
# 后端应只监听 127.0.0.1:8765，配置方式见 deploy/README.md。

# 方案一：仅在可信网络提供明文 HTTP，不用于传输管理口令。
# :80 {
#     reverse_proxy 127.0.0.1:8765
# }

# 方案二：公网域名和自动 HTTPS（推荐）。
# 将 charger.example.com 替换为指向该服务器的实际域名，并放行 TCP 80、443。
# charger.example.com {
#     reverse_proxy 127.0.0.1:8765
# }
